#!/bin/bash
# Extension: Dynamic Color Palette Notification (Dunst Drop-in Variant)

# 1. Source Pywal's active color variables
source "$HOME/.cache/wal/colors.sh"
OUTPUT_IMG="/tmp/wal_palette.png"

# 2. Build the color swatch image strip using ImageMagick
magick -size 600x60 xc:transparent \
  -fill "$color0" -draw "rectangle 0,0 75,60" \
  -fill "$color1" -draw "rectangle 75,0 150,60" \
  -fill "$color2" -draw "rectangle 150,0 225,60" \
  -fill "$color3" -draw "rectangle 225,0 300,60" \
  -fill "$color4" -draw "rectangle 300,0 375,60" \
  -fill "$color5" -draw "rectangle 375,0 450,60" \
  -fill "$color6" -draw "rectangle 450,0 525,60" \
  -fill "$color7" -draw "rectangle 525,0 600,60" \
  "$OUTPUT_IMG"

# 3. Get the exact monitor name where your cursor is right now via Hyprland
ACTIVE_MON=$(hyprctl activeworkspace -j | grep -oP '"monitor":\s*"\K[^"]+')

# 4. Generate Dunst's drop-in theme file dynamically
# This forces Dunst to read these exact hex codes regardless of your main config!
mkdir -p ~/.config/dunst/dunstrc.d
cat << DUNST_THEME > ~/.config/dunst/dunstrc.d/colors.conf
[global]
    monitor = $ACTIVE_MON

[urgency_low]
    background = "$color0"
    foreground = "$color7"
    frame_color = "$color4"

[urgency_normal]
    background = "$color0"
    foreground = "$color7"
    frame_color = "$color4"

[urgency_critical]
    background = "$color0"
    foreground = "$color1"
    frame_color = "$color1"
DUNST_THEME

# 5. Completely tear down and reload Dunst so it processes the drop-in file
pkill dunst
sleep 0.1
dunst &

# 6. Fire the notification toast on your active screen
sleep 0.15
notify-send -a "System Rice" -i "$OUTPUT_IMG" "Theme Generation Complete" "New palette successfully mapped across your environment."
