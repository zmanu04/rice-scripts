#!/bin/bash
# Extension: Dynamic Color Palette Notification (High-Speed Variant)

# 1. Source Wallust's direct variables immediately (No more sleep!)
VARS_FILE="$HOME/.cache/wallust/direct_vars.sh"
if [ -f "$VARS_FILE" ]; then
    source "$VARS_FILE"
else
    COLOR0="#000000"; COLOR1="#ff0000"; COLOR2="#00ff00"; COLOR3="#ffff00"
    COLOR4="#0000ff"; COLOR5="#ff00ff"; COLOR6="#00ffff"; COLOR7="#ffffff"
fi

# 2. Clear out old layout canvas assets
rm /tmp/palette_*.png 2>/dev/null
OUTPUT_IMG="/tmp/palette_$(date +%s).png"

# 3. Build the visual color swatch image strip using ImageMagick
magick -size 600x60 xc:transparent \
  -fill "$COLOR0" -draw "rectangle 0,0 75,60" \
  -fill "$COLOR1" -draw "rectangle 75,0 150,60" \
  -fill "$COLOR2" -draw "rectangle 150,0 225,60" \
  -fill "$COLOR3" -draw "rectangle 225,0 300,60" \
  -fill "$COLOR4" -draw "rectangle 300,0 375,60" \
  -fill "$COLOR5" -draw "rectangle 375,0 450,60" \
  -fill "$COLOR6" -draw "rectangle 450,0 525,60" \
  -fill "$COLOR7" -draw "rectangle 525,0 600,60" \
  "$OUTPUT_IMG"

# 4. Grab your focused monitor name immediately via Hyprland
ACTIVE_MON=$(hyprctl activeworkspace -j | grep -oP '"monitor":\s*"\K[^"]+')
if [ -z "$ACTIVE_MON" ]; then
    ACTIVE_MON="0"
fi

# 5. Safely cycle Dunst while pinning it directly to your current monitor screen
pkill dunst
sleep 0.02
dunst -mon "$ACTIVE_MON" &

# 6. Fire the notification toast instantly
sleep 0.05
notify-send -a "System Rice" -i "$OUTPUT_IMG" "Theme Generation Complete" "New palette successfully mapped across your environment."
