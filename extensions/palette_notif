#!/bin/bash
# Extension: Dynamic Color Palette Notification (Wallust JSON Variant)

CACHE_FILE="$HOME/.cache/wallust/colors.json"
OUTPUT_IMG="/tmp/wal_palette.png"

# 1. Fallback check: If Wallust hasn't run yet, skip image generation
if [ ! -f "$CACHE_FILE" ]; then
    notify-send -a "System Rice" "Theme Generation Complete" "Colors mapped across environment."
    exit 0
fi

# 2. Extract the exact hex values safely out of Wallust's JSON storage map using jq
COLOR0=$(jq -r '.colors.color0' "$CACHE_FILE")
COLOR1=$(jq -r '.colors.color1' "$CACHE_FILE")
COLOR2=$(jq -r '.colors.color2' "$CACHE_FILE")
COLOR3=$(jq -r '.colors.color3' "$CACHE_FILE")
COLOR4=$(jq -r '.colors.color4' "$CACHE_FILE")
COLOR5=$(jq -r '.colors.color5' "$CACHE_FILE")
COLOR6=$(jq -r '.colors.color6' "$CACHE_FILE")
COLOR7=$(jq -r '.colors.color7' "$CACHE_FILE")

# 3. Build the visual color swatch image strip using ImageMagick
magick -size 600x60 xc:transparent \
  -fill "$COLOR0" -draw "rectangle 0,0 75,60" \
  -fill "$COLOR1" -draw "rectangle 75,0 150,60" \
  -fill "$COLOR2" -draw "rectangle 150,0 225,60" \
  -fill "$COLOR3" -draw "rectangle 225,0 300,60" \
  -fill "$COLOR4" -draw "rectangle 300,0 375,60" \
  -fill "$COLOR5" -draw "rectangle 375,0 450,60" \
  -fill "$COLOR6" -draw "rectangle 450,0 525,60" \
  -fill "$COLOR7" -draw "rectangle 525,0 600,60" \
  "$OUTPUT_IMG"

# 4. Gracefully reload Dunst background service worker to pull the new file
pkill dunst
sleep 0.05
dunst &

# 5. Fire the notification toast showing your gorgeous new color palette!
sleep 0.1
notify-send -a "System Rice" -i "$OUTPUT_IMG" "Theme Generation Complete" "Wallust has successfully optimized your workspace colors."
